@@ -15,6 +15,24 @@
 #define LDBG(X) LLVM_DEBUG(DBGS() << X << "\n")
 
 namespace mlir::triton {
+
+// Triton-distributed patch: process-wide registry of out-of-tree AxisInfo visitor
+// callbacks (see registerExtraVisitorCallback in AxisInfo.h). Defined here in the
+// real `mlir::triton::axisinfo` namespace (not the file's anonymous namespace) so
+// the AxisInfoAnalysis constructor below can apply them.
+namespace axisinfo {
+static std::vector<CallbackType> &mutableExtraVisitorCallbacks() {
+  static std::vector<CallbackType> callbacks;
+  return callbacks;
+}
+const std::vector<CallbackType> &getExtraVisitorCallbacks() {
+  return mutableExtraVisitorCallbacks();
+}
+void registerExtraVisitorCallback(CallbackType callback) {
+  mutableExtraVisitorCallbacks().push_back(std::move(callback));
+}
+} // namespace axisinfo
